# Base URL used by the Axios instance (src/services/api.js).
#
# Default when unset: "/api" — the Vite dev server proxies /api/* to the
# local json-server running on http://localhost:3001 (see vite.config.js).
#
# To call the API directly instead of through the dev proxy, set it to the
# full URL. The API server must then allow cross-origin requests (CORS):
#
# VITE_API_URL=http://localhost:3001
VITE_API_URL=/api
